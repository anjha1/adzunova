# ==============================================================================
# Adzunova Environment Configuration Template (.env.example)
# Copy this file to .env and supply your local or production credentials.
# NEVER commit actual secret keys or credentials to version control.
# ==============================================================================

NODE_ENV=development
CELL_ID=cell-in-1

# --- Server Ports & Hostnames ---
PORT=3000
IDENTITY_SERVICE_PORT=4101
IDENTITY_SERVICE_HOST=0.0.0.0
IDENTITY_SERVICE_URL=http://127.0.0.1:4101

# --- Database ---
# Leave unset or use local mongodb; falls back to in-memory resilient store in development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/adzunova_identity
MONGODB_DB_NAME=adzunova_identity

# --- Google OAuth 2.0 Credentials ---
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# --- Authentication & Session Security ---
# Secret key used to sign session JWTs (minimum 32 characters in production)
AUTH_SESSION_SECRET=your-secure-session-signing-secret-min-32-chars
AUTH_COOKIE_NAME=adzunova_session

# --- Transactional Email (Brevo / SMTP) ---
# Optional in development (OTP codes are logged directly to the server terminal)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
OTP_FROM=noreply@adzunova.com

# --- Optional Microservices Infrastructure ---
KAFKA_BROKERS=localhost:9092
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=local_minio_only
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
LLM_API_KEY=


# ==========================================
# CLOUDFLARE R2 (Object Storage)
# ==========================================
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=public-assets
R2_PRIVATE_BUCKET_NAME=private-vault
R2_QUARANTINE_BUCKET_NAME=ingest-quarantine
R2_EXPORTS_BUCKET_NAME=exports-temp
NEXT_PUBLIC_CDN_BASE=https://cdn.adzunova.tech

# Per-role least-privilege R2 credentials (leave unset to disable that role cleanly)
R2_UPLOAD_SIGNER_ACCESS_KEY_ID=
R2_UPLOAD_SIGNER_SECRET_ACCESS_KEY=
R2_PROCESSOR_ACCESS_KEY_ID=
R2_PROCESSOR_SECRET_ACCESS_KEY=
R2_READER_ACCESS_KEY_ID=
R2_READER_SECRET_ACCESS_KEY=
R2_ADMIN_ACCESS_KEY_ID=
R2_ADMIN_SECRET_ACCESS_KEY=

# Dev-only R2 buckets (MUST start with adzunova-dev-) & optional local MinIO
R2_DEV_ENDPOINT=
R2_DEV_ACCESS_KEY_ID=
R2_DEV_SECRET_ACCESS_KEY=
R2_DEV_PUBLIC_BUCKET_NAME=adzunova-dev-public
R2_DEV_PRIVATE_BUCKET_NAME=adzunova-dev-private
R2_DEV_QUARANTINE_BUCKET_NAME=adzunova-dev-quarantine
R2_DEV_EXPORTS_BUCKET_NAME=adzunova-dev-exports
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Storage Metadata (MongoDB Replica Set for transactions)
# Local single-node replica set shape: mongodb://127.0.0.1:27017/adzunova?replicaSet=rs0
STORAGE_MONGODB_DB_NAME=adzunova_storage
FEATURE_STORAGE_UPLOADS=false
FEATURE_STORAGE_S1_PRESIGN=false
FEATURE_STORAGE_S2_MULTIPART=false
FEATURE_STORAGE_S3_PROCESSING=false
FEATURE_STORAGE_S4_SCANNER=false

# Malware Scanner (ClamAV clamd TCP zINSTREAM, M5)
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
CLAMAV_MAX_STREAM_BYTES=26214400
SCAN_WORKER_CONCURRENCY=2

# Presigned URL and upload session expiry (seconds)
R2_UPLOAD_URL_EXPIRY=3600
R2_DOWNLOAD_URL_EXPIRY=900
UPLOAD_SESSION_TTL_SECONDS=86400

# Multipart: equal part size except the last (64 MiB parts, multipart above 100 MiB)
R2_MULTIPART_PART_SIZE_BYTES=67108864
R2_MULTIPART_THRESHOLD_BYTES=104857600

# ==========================================
# UPLOAD LIMITS
# ==========================================
MAX_VIDEO_SIZE_BYTES=2147483648
MAX_PDF_SIZE_BYTES=10485760
MAX_IMAGE_SIZE_BYTES=5242880
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/webm
ALLOWED_PDF_MIME_TYPES=application/pdf
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp

# ==========================================
# AGREEMENTS & E-SIGN (M4)
# ==========================================
ESIGN_PROVIDER=off
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=
AGREEMENT_SIGN_WINDOW_HOURS=120