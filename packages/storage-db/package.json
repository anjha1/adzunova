{
  "name": "@adzunova/storage-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "indexes:up": "node src/index-bootstrap.mjs up",
    "indexes:down": "node src/index-bootstrap.mjs down",
    "indexes:verify": "node src/index-bootstrap.mjs verify",
    "migrate:up": "node src/migration-runner.mjs up",
    "migrate:down": "node src/migration-runner.mjs down",
    "migrate:dry-run": "node src/migration-runner.mjs up --dry-run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "mongodb": "^7.9.0",
    "prisma": "6.19.3"
  }
}
