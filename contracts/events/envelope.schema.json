{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdzunovaEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "aggregate_id",
    "cell_id",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "org_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "cell_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "traceparent": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
