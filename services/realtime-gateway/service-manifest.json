{
  "name": "realtime-gateway",
  "domain": "Realtime",
  "architecture": "domain-driven-microservice",
  "language": "typescript",
  "port": 4117,
  "data_ownership": {
    "database": "realtime_db",
    "owns_data": true,
    "cross_service_database_access": false
  },
  "dependencies": [
    "postgres",
    "redis",
    "kafka"
  ],
  "publishes": [
    "realtime.events.v1"
  ],
  "consumes": [
    "communication.events.v1"
  ],
  "deployment": {
    "independent": true
  },
  "slo_targets": {
    "availability": "99.9%",
    "p95_latency_ms": 300
  }
}
