{
  "name": "content-service",
  "domain": "Content",
  "architecture": "domain-driven-microservice",
  "language": "typescript",
  "port": 4114,
  "data_ownership": {
    "database": "content_db",
    "owns_data": true,
    "cross_service_database_access": false
  },
  "dependencies": [
    "postgres",
    "kafka",
    "minio"
  ],
  "publishes": [
    "content.events.v1"
  ],
  "consumes": [
    "booking.events.v1"
  ],
  "deployment": {
    "independent": true
  },
  "slo_targets": {
    "availability": "99.9%",
    "p95_latency_ms": 300
  }
}
