datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CREATOR
  BRAND
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
  RESTRICTED_WORK_EMAIL_REQUIRED
}

enum ProfileStatus {
  DRAFT
  PENDING_REVIEW
  VERIFIED
  COMPLETED
  REJECTED
}

enum BrandVerificationState {
  PENDING
  VERIFIED
  RESTRICTED
  SUSPENDED
}

enum BrandAccountType {
  BRAND
  AGENCY
  ENTERPRISE
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_AUTH
  LOGIN_CONFIRMATION
}

model User {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  email            String          @unique
  normalizedEmail  String          @unique
  passwordHash     String?
  role             UserRole        @default(CREATOR)
  emailVerified    Boolean         @default(false)
  status           AccountStatus   @default(ACTIVE)
  lastLoginAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  accounts         Account[]
  creatorProfile   CreatorProfile?
  brandProfile     BrandProfile?
  sessions         Session[]
  otps             Otp[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Account {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // e.g., "google"
  providerAccountId String   // google user id
  providerEmail     String?
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model CreatorProfile {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  userId              String        @unique @db.ObjectId
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String
  category            String?
  country             String?
  bio                 String?
  avatarUrl           String?
  portfolioUrl        String?
  socialLinks         Json?         // { youtube: string, instagram: string, tiktok: string, etc. }
  onboardingCompleted Boolean       @default(false)
  onboardingStep      Int           @default(1)
  profileStatus       ProfileStatus @default(DRAFT)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("creator_profiles")
}

model BrandProfile {
  id                  String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId              String                 @unique @db.ObjectId
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactName         String
  companyName         String
  brandName           String?
  website             String?
  industry            String?
  businessType        String?
  accountType         BrandAccountType       @default(BRAND)
  country             String?
  logoUrl             String?
  companySize         String?
  pan                 String?
  gstin               String?
  cin                 String?
  legalAddress        Json?
  billingContact      Json?
  verificationStatus  BrandVerificationState @default(PENDING)
  verificationDetails String?
  verifiedAt          DateTime?
  domainVerified      Boolean                @default(false)
  dpdpConsent         Json?
  checklistState      Json?
  onboardingCompleted Boolean                @default(false)
  onboardingStep      Int                    @default(1)
  profileStatus       ProfileStatus          @default(DRAFT)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@map("brand_profiles")
}

model VerificationAuditLog {
  id             String                 @id @default(auto()) @map("_id") @db.ObjectId
  brandProfileId String                 @db.ObjectId
  actorId        String                 @db.ObjectId
  previousState  BrandVerificationState
  newState       BrandVerificationState
  reason         String
  metadata       Json?
  createdAt      DateTime               @default(now())

  @@index([brandProfileId])
  @@map("verification_audit_logs")
}

model Session {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @db.ObjectId
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             UserRole
  sessionTokenHash String    @unique
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Otp {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  userId      String     @db.ObjectId
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  purpose     OtpPurpose
  targetEmail String
  expiresAt   DateTime
  attempts    Int        @default(0)
  usedAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, purpose])
  @@index([targetEmail, purpose])
  @@index([expiresAt])
  @@map("otps")
}

model PasswordResetToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PublicProfile {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  creatorId          String    @unique
  slug               String    @unique
  previousSlugs      String[]  @default([])
  isPublished        Boolean   @default(false)
  allowIndexing      Boolean   @default(true)
  displayName        String
  bio                String?
  tags               String[]  @default([])
  languages          String[]  @default([])
  location           String?
  avatarUrl          String?
  coverUrl           String?
  sectionVisibility  Json?
  hiddenPlatformIds  String[]  @default([])
  pinnedContentIds   String[]  @default([])
  hidePricesPerItem  Json?
  consentRecordedAt  DateTime?
  publishedAt        DateTime?
  updatedAt          DateTime  @updatedAt
  version            Int       @default(1)

  @@map("public_profiles")
}

model PlatformSnapshot {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  creatorId          String
  platform           String
  handle             String
  profileUrl         String?
  followers          Int       @default(0)
  avgViews           Int       @default(0)
  engagementRate     Float     @default(0.0)
  contentCount       Int       @default(0)
  verificationStatus String    @default("UNVERIFIED")
  verifiedAt         DateTime?
  source             String?
  trendSeries        Json?
  fetchedAt          DateTime  @default(now())

  @@index([creatorId, platform])
  @@index([fetchedAt])
  @@map("platform_snapshots")
}

model ProfileViewEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId   String
  timestamp   DateTime @default(now())
  referrer    String?
  country     String?
  deviceType  String?
  sessionHash String
  eventType   String
  metadata    Json?

  @@index([profileId, timestamp])
  @@index([profileId, eventType])
  @@map("profile_view_events")
}

model ProfileReport {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  profileId    String
  slug         String
  reason       String
  details      String
  reporterHash String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  @@index([profileId, createdAt])
  @@map("profile_reports")
}

enum DomainRuleKind {
  FREE
  DISPOSABLE
  BLOCKED
  ALLOWED_EXCEPTION
}

model EmailDomainRule {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  domain    String         @unique
  kind      DomainRuleKind
  source    String?
  addedBy   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([kind])
  @@map("email_domain_rules")
}

model DomainClaim {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String
  domain          String    @unique
  verificationTxt String
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
  @@map("domain_claims")
}

enum WorkspaceType {
  BRAND
  AGENCY
  ENTERPRISE
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalType {
  BOOKING_CREATION
  CAMPAIGN_LAUNCH
  PAYMENT_RELEASE
}

model Workspace {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  slug               String        @unique
  type               WorkspaceType @default(BRAND)
  ownerId            String
  billingCurrency    String        @default("INR")
  ipAllowlist        String[]      @default([])
  twoFactorRequired  Boolean       @default(false)
  approvalThresholds Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([ownerId])
  @@map("workspaces")
}

model Brand {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String
  name        String
  logoUrl     String?
  website     String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workspaceId])
  @@map("brands")
}

model WorkspaceMember {
  id                 String       @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId        String
  userId             String
  email              String
  role               String       @default("VIEWER")
  customRoleId       String?
  brandIds           String[]     @default([])
  approvalLimitMinor Int?
  status             MemberStatus @default(ACTIVE)
  joinedAt           DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("members")
}

model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId String?
  name        String
  slug        String
  description String?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workspaceId, slug])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  roleId       String
  action       String
  resourceType String
  conditions   Json?
  createdAt    DateTime @default(now())

  @@index([roleId])
  @@map("role_permissions")
}

model WorkspaceInvitation {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId     String
  email           String
  role            String           @default("CAMPAIGN_MANAGER")
  brandIds        String[]         @default([])
  invitedByUserId String
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@index([workspaceId])
  @@index([email])
  @@map("invitations")
}

model Approval {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String
  brandId        String?
  type           ApprovalType
  resourceId     String
  requesterId    String
  approverId     String?
  decision       ApprovalDecision @default(PENDING)
  reason         String?
  amountMinor    Int?
  currency       String           @default("INR")
  slaDeadline    DateTime?
  escalationPath String?
  decidedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([workspaceId])
  @@index([requesterId])
  @@index([approverId])
  @@map("approvals")
}

model ApprovalRule {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId    String
  actionType     String
  minAmountMinor Int
  requiredRole   String
  slaHours       Int      @default(24)
  createdAt      DateTime @default(now())

  @@index([workspaceId])
  @@map("approval_rules")
}

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  workspaceId  String
  actorId      String
  actorEmail   String?
  actorIp      String?
  action       String
  resourceType String
  resourceId   String
  previousHash String
  hash         String
  payload      Json?
  createdAt    DateTime @default(now())

  @@index([workspaceId])
  @@index([actorId])
  @@index([hash])
  @@map("audit_log")
}
