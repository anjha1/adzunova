{
  "name": "identity-service",
  "domain": "Identity",
  "architecture": "domain-driven-microservice",
  "language": "typescript",
  "port": 4101,
  "data_ownership": {
    "database": "identity_db",
    "owns_data": true,
    "cross_service_database_access": false
  },
  "dependencies": [
    "postgres",
    "redis"
  ],
  "publishes": [
    "identity.events.v1"
  ],
  "consumes": [
    "user.events.v1"
  ],
  "deployment": {
    "independent": true
  },
  "slo_targets": {
    "availability": "99.9%",
    "p95_latency_ms": 300
  }
}
