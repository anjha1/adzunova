{
  "name": "fraud-service",
  "domain": "Fraud",
  "architecture": "domain-driven-microservice",
  "language": "typescript",
  "port": 4115,
  "data_ownership": {
    "database": "fraud_db",
    "owns_data": true,
    "cross_service_database_access": false
  },
  "dependencies": [
    "postgres",
    "kafka"
  ],
  "publishes": [
    "fraud.events.v1"
  ],
  "consumes": [
    "identity.events.v1",
    "booking.events.v1",
    "payment.events.v1"
  ],
  "deployment": {
    "independent": true
  },
  "slo_targets": {
    "availability": "99.9%",
    "p95_latency_ms": 300
  }
}
